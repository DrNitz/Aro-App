<?xml version="1.0" encoding="utf-8"?><!--
    Aro is a privacy-first, offline-first app: every byte of the user's health data
    stays on their device. Cloud backup is therefore disabled for all app data.

    Manual, user-controlled backup is still available through the in-app
    Data Management screen (export / import a .json file), which is the only path
    Aro intends to use.

    Note: this file is ignored on devices older than API 31; see
    https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>